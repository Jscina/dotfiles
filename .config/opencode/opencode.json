{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@ex-machina/opencode-anthropic-auth@next", "/Users/jscina/.openagent-harness"],
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
        }
      },
      "azure": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@azure/mcp@latest",
          "server",
          "start",
          "--read-only",
          "--disable-proxy-tools",
          "--namespace",
          "monitor",
          "--namespace",
          "compute",
          "--namespace",
          "group",
          "--namespace",
          "resourcehealth",
          "--namespace",
          "aks",
          "--namespace",
          "applicationinsights"
        ],
        "environment": {
          "DOTNET_BUNDLE_EXTRACT_BASE_DIR": "/tmp/claude/dotnet-extract"
        }
      },
      "ado": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@azure-devops/mcp@2.10.0",
          "{env:ADO_ORG}",
          "--authentication",
          "envvar"
        ],
        "environment": {
          "NODE_OPTIONS": "--require=/Users/jscina/dotfiles/.config/srt/mcp-ado-preload.cjs"
        }
      },
      "websearch": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp@latest",
          "--api-key",
          "{env:UPSTASH_CONTEXT7_KEY}"
        ]
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      }
    },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "experimental": {
    "subagent_depth": 2
  },
  "providers": {
    "ollama": {
      "name": "Ollama",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b": {
          "name": "qwen3.6:35b-a3b",
          "capabilities": {
            "tools": true
          }
        },
        "qwen2.5-coder:7b-base": {
