{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@ex-machina/opencode-anthropic-auth@1.8.6",
    "/Users/jscina/.openagent-harness/harness.ts"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
      }
    },
    "azure": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure/mcp@latest",
        "server",
        "start",
        "--read-only",
        "--disable-proxy-tools",
        "--namespace",
        "monitor",
        "--namespace",
        "compute",
        "--namespace",
        "group",
        "--namespace",
        "resourcehealth",
        "--namespace",
        "aks",
        "--namespace",
        "applicationinsights"
      ]
    },
    "ado": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure-devops/mcp@2.10.0",
        "{env:ADO_ORG}",
        "--authentication",
        "envvar"
      ],
      "environment": {
        "NODE_OPTIONS": "--require=/Users/jscina/dotfiles/.config/srt/mcp-ado-preload.cjs"
      }
    },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "subagent_depth": 2,
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-orchestrator:latest": {
          "reasoning": true,
          "tool_call": true,
          "name": "qwen3-orchestrator:latest"
        },
        "qwen3-coder-builder:latest": {
          "tool_call": true,
          "name": "qwen3-coder-builder:latest"
        },
        "qwen3-coder-junior:latest": {
          "tool_call": true,
          "name": "qwen3-coder-junior:latest"
        },
        "qwen3-docs:latest": {
          "reasoning": true,
          "tool_call": true,
          "name": "qwen3-docs:latest"
        },
        "qwen2.5-vl-vision": {
          "tool_call": false,
          "name": "qwen2.5-vl-vision:latest"
        }
      }
    }
  },
  "permission": {
