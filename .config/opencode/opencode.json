{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@ex-machina/opencode-anthropic-auth@next",
    "/Users/jscina/.openagent-harness/harness.ts"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
      }
    },
    "azure": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure/mcp@latest",
        "server",
        "start",
        "--read-only",
        "--disable-proxy-tools",
        "--namespace",
        "monitor",
        "--namespace",
        "compute",
        "--namespace",
        "group",
        "--namespace",
        "resourcehealth",
        "--namespace",
        "aks",
        "--namespace",
        "applicationinsights"
      ]
    },
    "ado": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure-devops/mcp@2.10.0",
        "{env:ADO_ORG}",
        "--authentication",
        "envvar"
      ],
      "environment": {
        "NODE_OPTIONS": "--require=/Users/jscina/dotfiles/.config/srt/mcp-ado-preload.cjs"
      }
    },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest",
        "--api-key",
        "{env:UPSTASH_CONTEXT7_KEY}"
      ]
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "subagent_depth": 2,
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b": {
          "reasoning": true,
          "tool_call": true,
          "name": "qwen3.6:35b-a3b"
        },
        "qwen2.5-coder:7b-base": {
          "tool_call": true,
          "name": "qwen2.5-coder:7b-base"
        }
      }
    }
  },
