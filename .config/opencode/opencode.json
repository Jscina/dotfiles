{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@ex-machina/opencode-anthropic-auth@next", "/home/joshs/.openagent-harness/harness.ts"],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
        }
      },
      "websearch": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      }
    }
  },
  "experimental": {
    "subagent_depth": 2
  },
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "providers": {
    "ollama": {
      "name": "Ollama",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b": {
          "name": "qwen3.6:35b-a3b",
          "capabilities": { "tools": true }
        },
        "qwen2.5-coder:7b-base": {
          "name": "qwen2.5-coder:7b-base",
          "capabilities": { "tools": false }
        }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr *", "effect": "deny" },
    { "action": "shell", "resource": "rm -r -f *", "effect": "deny" },
    { "action": "shell", "resource": "rm -f -r *", "effect": "deny" },
    { "action": "shell", "resource": "rm -Rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fR *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "npm publish *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "*.zsh_history*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "subagent", "resource": "*", "effect": "allow" },

    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.ssh", "effect": "deny" },
    { "action": "read", "resource": "*.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*.secrets", "effect": "deny" },
    { "action": "read", "resource": "*.netrc", "effect": "deny" },
    { "action": "read", "resource": "*.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "*.npmrc", "effect": "deny" },
    { "action": "read", "resource": "*.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "*.m2/settings.xml", "effect": "deny" },
    { "action": "read", "resource": "*.kube/config", "effect": "deny" },
    { "action": "read", "resource": "*.config/gh/hosts.yml", "effect": "deny" },
    { "action": "read", "resource": "*.gradle/daemon/*", "effect": "deny" },
    { "action": "read", "resource": "*.zsh_history", "effect": "deny" },
    { "action": "read", "resource": "*.zsh_sessions/*", "effect": "deny" },
    { "action": "read", "resource": "*.bash_history", "effect": "deny" },
    { "action": "read", "resource": "*.python_history", "effect": "deny" },

    { "action": "edit", "resource": "*.ssh", "effect": "deny" },
    { "action": "edit", "resource": "*.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "*.secrets", "effect": "deny" },
    { "action": "edit", "resource": "*.netrc", "effect": "deny" },
    { "action": "edit", "resource": "*.git-credentials", "effect": "deny" },
    { "action": "edit", "resource": "*.npmrc", "effect": "deny" },
    { "action": "edit", "resource": "*.docker/config.json", "effect": "deny" },
    { "action": "edit", "resource": "*.m2/settings.xml", "effect": "deny" },
    { "action": "edit", "resource": "*.kube/config", "effect": "deny" },
    { "action": "edit", "resource": "*.gradle/daemon/*", "effect": "deny" },
    { "action": "edit", "resource": "*.zsh_history", "effect": "deny" },
    { "action": "edit", "resource": "*.zsh_sessions/*", "effect": "deny" },
    { "action": "edit", "resource": "*.bash_history", "effect": "deny" },
    { "action": "edit", "resource": "*.python_history", "effect": "deny" },

    { "action": "edit", "resource": "*opencode.json", "effect": "deny" },
    { "action": "edit", "resource": "*opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": "*.mcp.json", "effect": "deny" },
    { "action": "edit", "resource": "*.config/opencode/*", "effect": "deny" },
    { "action": "edit", "resource": "*.config/nvim/*", "effect": "deny" },
    { "action": "edit", "resource": "*dotfiles/bin/*", "effect": "deny" },
    { "action": "edit", "resource": "*.bun/*", "effect": "deny" },
    { "action": "edit", "resource": "*.zshrc", "effect": "deny" },

    { "action": "edit", "resource": "*.git/hooks/*", "effect": "deny" },
    { "action": "edit", "resource": "*.git/config", "effect": "deny" },
    { "action": "edit", "resource": "*.git/modules/*/hooks/*", "effect": "deny" },
    { "action": "edit", "resource": "*.git/modules/*/config", "effect": "deny" },
    { "action": "edit", "resource": "*.gitmodules", "effect": "deny" },
    { "action": "edit", "resource": "*.vscode/*", "effect": "deny" },
    { "action": "edit", "resource": "*.idea/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/agent/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/agents/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/plugin/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/plugins/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/command/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/commands/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/skill/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/skills/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/tool/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/tools/*", "effect": "deny" }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "scout": {
      "disabled": true
    },
    "summary": {
      "disabled": true
    },
    "title": {
      "model": "anthropic/claude-haiku-4-5"
    },
    "compaction": {
      "model": "anthropic/claude-sonnet-5-5"
    }
  }
}
