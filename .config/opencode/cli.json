{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "input.newline": "shift+return,ctrl+return,alt+return,ctrl+j"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "permissions": "prompt"
  },
  "animations": true,
  "attention": {
    "notifications": true
  },
  "debug": {
    "devtools": false
  },
  "terminal": {
    "title": true
  }
}
